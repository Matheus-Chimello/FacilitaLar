<% if (pages > 1) { %><nav class="notification-pagination" aria-label="Páginas de avaliações">
  <% if (page > 1) { %><a class="notification-icon-button" href="<%= pageUrl(page - 1) %>" title="Página anterior" aria-label="Página anterior"><i class="fa fa-chevron-left" aria-hidden="true"></i></a><% } %>
  <span>Página <%= page %> de <%= pages %></span>
  <% if (page < pages) { %><a class="notification-icon-button" href="<%= pageUrl(page + 1) %>" title="Próxima página" aria-label="Próxima página"><i class="fa fa-chevron-right" aria-hidden="true"></i></a><% } %>
</nav><% } %>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="app-main">
  <section class="split-form-layout">
    <aside class="summary-panel">
      <img src="<%= service.image || '/assets/images/services-bg.jpg' %>" alt="<%= service.title %>">
      <span class="category-pill"><%= service.category_name %></span>
      <h1><%= service.title %></h1>
      <p><%= service.description %></p>
      <strong><%= formatCurrency(service.price) %></strong>
      <small><%= service.provider_name %> · <%= service.service_area %> · <%= service.duration_minutes %> min</small>
    </aside>

    <section class="form-panel">
      <div class="form-heading">
        <p class="eyebrow">Solicitação</p>
        <h2>Dados do atendimento</h2>
      </div>
      <form action="/contratante/solicitar/<%= service.id %>" method="post">
        <div class="form-row">
          <div class="form-group col-sm-6">
            <label for="booking-date">Data</label>
            <input class="form-control" id="booking-date" name="date" type="date" min="<%= minDate %>" max="<%= maxDate %>" value="<%= form.date %>" required>
          </div>
          <div class="form-group col-sm-6">
            <label for="booking-time">Horário disponível</label>
            <select class="form-control" id="booking-time" name="time" data-endpoint="/servicos/<%= service.id %>/horarios" required <%= slots.length ? '' : 'disabled' %>>
              <option value="">Selecione</option>
              <% slots.forEach((slot) => { %><option value="<%= slot %>" <%= form.time === slot ? 'selected' : '' %>><%= slot %></option><% }) %>
            </select>
          </div>
        </div>
        <p class="booking-status" id="booking-status" role="status"><%= slots.length ? `${slots.length} horários disponíveis nesta data.` : 'Nenhum horário disponível nesta data.' %></p>
        <div class="form-group">
          <label for="address">Endereço</label>
          <input class="form-control" id="address" name="address" maxlength="200" autocomplete="street-address" value="<%= form.address || '' %>" required>
        </div>
        <div class="form-group">
          <label for="notes">Observações</label>
          <textarea class="form-control" id="notes" name="notes" rows="4" maxlength="2000"><%= form.notes || '' %></textarea>
        </div>
        <div class="button-row">
          <a class="btn btn-outline-secondary" href="/servicos/<%= service.id %>">Voltar</a>
          <button class="btn btn-primary" type="submit" <%= slots.length ? '' : 'disabled' %>>Solicitar horário</button>
        </div>
      </form>
    </section>
  </section>
</main>

<script src="/public/js/booking.js" defer></script>
<%- include('../partials/footer') %>

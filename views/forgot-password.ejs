<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<main class="app-main narrow-main">
  <section class="form-panel">
    <div class="form-heading"><p class="eyebrow">Acesso</p><h1>Redefinir senha</h1></div>
    <form action="/esqueci-senha" method="post">
      <%- include('partials/csrf') %>
      <div class="form-group"><label for="reset-email">E-mail</label><input class="form-control" id="reset-email" name="email" type="email" maxlength="254" autocomplete="email" value="<%= email %>" required></div>
      <button class="btn btn-primary btn-block" type="submit">Enviar link de redefinição</button>
    </form>
    <% if (devUrl) { %><p class="form-note">Ambiente local: <a href="<%= devUrl %>">Abrir link de redefinição</a></p><% } %>
    <p class="form-link"><a href="/entrar">Voltar para entrar</a></p>
  </section>
</main>

<%- include('partials/footer') %>

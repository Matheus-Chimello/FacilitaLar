NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=

# Configure os pares abaixo para ativar os botões de login externo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# consumers = contas pessoais; para contas de uma organização, use o ID do tenant.
MICROSOFT_TENANT_ID=consumers

# Obrigatório em produção para confirmação de e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Necessário somente se o HTTPS terminar em um proxy confiável.
TRUST_PROXY=0

# Apenas na criação do primeiro administrador em produção.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
